From 8277d604d6e63a3dc98cd0e9f9ed524438bd06a3 Mon Sep 17 00:00:00 2001
From: Gabriel Berfield <gabriel.berfield@gmail.com>
Date: Sat, 24 Oct 2026 06:45:21 -0700
Subject: [PATCH 1/2] client: Handle system bus connection failures

Report the system-bus connection error and exit before attaching the
object manager when the connection is unavailable. This avoids a libdbus
assertion abort in restricted environments and releases the initialized
shell state on failure.

Backport of upstream commit a57c6d52e7cc87e30768d09aadff4c7b3a736938
for BlueZ 5.87.

Link: https://github.com/bluez/bluez/issues/2446
Assisted-by: Codex:GPT-6
---
 client/main.c | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/client/main.c b/client/main.c
index 9d9ac8b..05ac07b 100644
--- a/client/main.c
+++ b/client/main.c
@@ -3982,6 +3982,7 @@ static bool timeout_quit(void *user_data)
 int main(int argc, char *argv[])
 {
 	GDBusClient *client;
+	DBusError error;
 	int status;
 	int timeout;
 	unsigned int timeout_id;
@@ -4012,7 +4013,18 @@ int main(int argc, char *argv[])
 	else
 		auto_register_agent = g_strdup("");
 
-	dbus_conn = g_dbus_setup_bus(DBUS_BUS_SYSTEM, NULL, NULL);
+	dbus_error_init(&error);
+	dbus_conn = g_dbus_setup_bus(DBUS_BUS_SYSTEM, NULL, &error);
+	if (!dbus_conn) {
+		fprintf(stderr, "Failed to connect to system D-Bus: %s\n",
+				error.message ? error.message : "unavailable");
+		dbus_error_free(&error);
+		g_free(auto_register_agent);
+		bt_shell_cleanup();
+		return EXIT_FAILURE;
+	}
+
+	dbus_error_free(&error);
 	g_dbus_attach_object_manager(dbus_conn);
 
 	bt_shell_set_env("DBUS_CONNECTION", dbus_conn);
